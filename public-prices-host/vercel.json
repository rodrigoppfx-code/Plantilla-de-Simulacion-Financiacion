{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/precios.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/config.json", "destination": "https://rodrigoppfx-code.github.io/Plantilla-de-Simulacion-Financiacion/config.json" }
  ],
  "headers": [
    { "source": "/precios.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/assets/vendor/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/config.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
